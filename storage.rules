rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // --- FUNGSI BANTUAN ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isSuperAdmin() { 
      return request.auth != null && request.auth.token.email == 'deny.wismoyo@gmail.com'; 
    }
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024
          && request.resource.contentType.matches('image/.*');
    }

    // --- 1. FOLDER ASSESSMENTS (FILE UPLOAD PESERTA) ---
    // User yang terautentikasi bisa upload file milik mereka sendiri.
    // Admin (superadmin) bisa membaca semua file assessment.
    match /assessments/{userId}/{allPaths=**} {
      // Siapapun yang sudah login bisa membaca file assessment
      allow read: if isAuthenticated();
      // Hanya pemilik file (userId cocok dengan uid auth) yang bisa menulis
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // --- 2. FOLDER PORTOFOLIO ---
    match /portfolio-assets/{allPaths=**} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidImage();
      allow update, delete: if isAuthenticated();
    }

    // --- 3. FOLDER IMAGES ---
    match /images/{allPaths=**} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidImage();
      allow update, delete: if isAuthenticated();
    }

    // --- 4. CURATION FILES - LOGO (HANYA SUPERADMIN) ---
    match /curation_files/1_logo/{allPaths=**} {
      allow read: if true;
      allow write: if isSuperAdmin(); 
    }

    // --- 5. FOLDER CURATION FILES ---
    match /curation_files/{allPaths=**} {
      allow read, write: if true;
    }

    // --- 6. ARTIKEL ---
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // --- 7. FOLDER PROMO ASSETS (HASIL RENDER AI) ---
    match /promo_assets/{allPaths=**} {
      allow read: if true; 
      allow delete: if isAuthenticated(); 
    }

    // --- 8. FOLDER STUDY KB (KNOWLEDGE BASE KAJIAN) ---
    match /study_kb/{allPaths=**} {
      allow read: if isAuthenticated();
      // Untuk upload, user harus terautentikasi.
      // Opsional: validasi file pdf/docx bisa ditambah.
      allow write: if isAuthenticated();
    }
    
    // --- 9. FOLDER STUDY PROJECTS ---
    match /study_projects/{allPaths=**} {
      allow read, write: if isAuthenticated();
    }
    
    // --- 10. BLOKIR SEMUA FOLDER LAINNYA ---
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
